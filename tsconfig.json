
{
    "compilerOptions": {
      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "noEmit": true,
      "types": ["node", "@playwright/test"]
    },
    "include": [
      "tests/**/*.ts",
      "playwright.config.ts",
      "reporting-labs.config.ts"
    ],
    "exclude": ["node_modules"]
  }
  